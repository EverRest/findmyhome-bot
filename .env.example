# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=log
# LOG_LEVEL=debug  # verbose: gmail, parse, score, telegram per-item
DATABASE_URL=file:./data/findmyhome.db
CRITERIA_PATH=./config/criteria.yaml
GMAIL_QUERY=newer_than:1d
PIPELINE_DRY_RUN=false
PIPELINE_API_KEY=change-me
TOP_N=10
# Pipeline cron (Nest @nestjs/schedule). Every 3h at :00 — override as needed.
PIPELINE_CRON_ENABLED=true
CRON_EXPRESSION='0 */3 * * *'
SCORE_CACHE_DAYS=7
TELEGRAM_REPOST_AFTER_DAYS=0
RISK_AUTO_HIDE=false

# Gmail OAuth — Web client; redirect http://localhost:3333/oauth2callback
# npm run gmail:auth → secrets/gmail-token.json (or set GMAIL_REFRESH_TOKEN)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Ollama on host Mac (not in Docker) — saves GPU/RAM in container
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
# false = rules-only scoring (recommended until prompts are tuned)
OLLAMA_SCORING_ENABLED=true
MIN_DIGEST_SCORE=25
MIN_DIGEST_RENT_EUR=200

# Telegram group
TELEGRAM_BOT_TOKEN=
TELEGRAM_DELIVERY_MODE=group
TELEGRAM_CHAT_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
# Rate limits: max cards per pipeline run (inline mode), pause between messages, 429 retries
TELEGRAM_MAX_SEND_PER_RUN=10
TELEGRAM_SEND_DELAY_MS=2500
TELEGRAM_MAX_RETRIES=5

# Facebook groups (Playwright + saved session). One-time: npm run facebook:login
FACEBOOK_INGESTION_ENABLED=false
# Comma-separated numeric group IDs from facebook.com/groups/123456789
FACEBOOK_GROUP_IDS=
FACEBOOK_STORAGE_STATE_PATH=./secrets/facebook-storage.json
FACEBOOK_LOOKBACK_HOURS=24
FACEBOOK_HEADLESS=true
FACEBOOK_GROUP_DELAY_MS=3000
FACEBOOK_MAX_SCROLLS=4

# BullMQ + Redis — staggered digest (off by default). Needs: npm run redis:up
BULLMQ_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
