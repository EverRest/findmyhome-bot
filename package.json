{
  "name": "findmyhome",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "gmail:auth": "ts-node -r dotenv/config scripts/gmail-auth.ts",
    "telegram:chat-id": "ts-node -r dotenv/config scripts/telegram-get-chat-id.ts",
    "gmail:list": "ts-node -r dotenv/config scripts/gmail-list-recent.ts",
    "debug:casa": "ts-node -r dotenv/config scripts/debug-casa-email.ts",
    "db:inspect": "ts-node -r dotenv/config scripts/db-inspect.ts",
    "db:reset-immobiliare": "ts-node -r dotenv/config scripts/reset-immobiliare-data.ts",
    "db:reset-portals": "ts-node -r dotenv/config scripts/reset-portal-emails.ts",
    "debug:idealista": "ts-node -r dotenv/config scripts/debug-idealista-email.ts",
    "facebook:login": "ts-node -r dotenv/config scripts/facebook-login.ts",
    "facebook:probe": "ts-node -r dotenv/config scripts/facebook-graph-probe.ts",
    "db:rescore": "ts-node -r dotenv/config scripts/rescore-listings.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "pipeline:dry": "PIPELINE_DRY_RUN=true nest start",
    "redis:up": "docker compose --profile mac up -d redis",
    "prepare": "husky",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,yml,yaml,mjs}\" \"docs/**/*.md\" \"config/*.{yaml,yml}\" \".github/**/*.{yml,yaml}\"",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm run test:ci",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --coverage --ci --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test:ci",
    "coverage:open": "open coverage/lcov-report/index.html"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.77.6",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "googleapis": "^172.0.0",
    "ioredis": "^5.11.0",
    "js-yaml": "^4.1.1",
    "nestjs-telegraf": "^2.9.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
